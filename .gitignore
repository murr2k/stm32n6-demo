# Python
__pycache__/
*.py[cod]
.venv/

# west workspace externals (recreate with `west update`). Root-anchored so
# directories with the same names inside our own tree are not ignored.
/.west/
/zephyr/
/modules/
/bootloader/
# ST's ISP middleware (licence SLA0044: must not be put under open-source
# terms, so it is never committed here; west fetches it)
/st/

# Build outputs
/build/
/build-*/
*.o
*.obj
*.elf
*.hex
*.map
*.lst

# Generated media (rebuilt by tools/video); sources stay in git
/media/out/
/media/cache/

# Captures pulled off the board during bring-up
/captures/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Secrets
.env
*.secret.*

# Face signatures and other personal data: they live on the board's card only
# (CLAUDE.md), never here
*.n6face
/faces/
**/faces.db

# Node tooling for font generation
/tools/fontconv/node_modules/
