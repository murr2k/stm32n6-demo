# The media path drives the JPEG codec, DMA2D and the SAI (audio out, with a
# circular GPDMA transfer) through the ST HAL directly:
# Zephyr 4.4.0's JPEG driver only encodes. These HAL modules are hidden
# symbols that drivers normally select, so select them here.
config APP_MEDIA
	bool "Hardware JPEG decode path"
	default y
	select USE_STM32_HAL_JPEG
	select USE_STM32_HAL_DMA2D
	select USE_STM32_HAL_SAI
	select USE_STM32_HAL_DMA
	select USE_STM32_HAL_DMA_EX

# The N657's Cortex-M55 has a double-precision FPU (MVFR0 = 0x10110221, FPDP
# field = 2), but Zephyr 4.4.0's SoC definition only selects CPU_HAS_FPU, so
# the build used -mfpu=fpv5-sp-d16 and every `double` operation was a library
# call. That cost Explorer 2 to 5 ms a frame.
config APP_FPU_DOUBLE
	bool "Use the double-precision FPU"
	default y
	select CPU_HAS_FPU_DOUBLE_PRECISION

source "Kconfig.zephyr"
