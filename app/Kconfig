# The media path drives the JPEG codec, DMA2D, the SAI (audio out, with a
# circular GPDMA transfer) and the MDF (microphone in) through the ST HAL directly:
# Zephyr 4.4.0's JPEG driver only encodes. These HAL modules are hidden
# symbols that drivers normally select, so select them here.
config APP_MEDIA
	bool "Hardware JPEG decode path"
	default y
	select USE_STM32_HAL_JPEG
	select USE_STM32_HAL_DMA2D
	select USE_STM32_HAL_SAI
	select USE_STM32_HAL_MDF
	select USE_STM32_HAL_DMA
	select USE_STM32_HAL_DMA_EX

# The N657's Cortex-M55 has a double-precision FPU (MVFR0 = 0x10110221, FPDP
# field = 2), but Zephyr 4.4.0's SoC definition only selects CPU_HAS_FPU, so
# the build used -mfpu=fpv5-sp-d16 and every `double` operation was a library
# call. That cost Explorer 2 to 5 ms a frame.
config APP_FPU_DOUBLE
	bool "Use the double-precision FPU"
	default y
	select CPU_HAS_FPU_DOUBLE_PRECISION

# The NPU: ST's runtime (built only when build-nn/ holds converted networks,
# see tools/nn.py) maintains the NPU cache through the HAL and installs its
# interrupt handlers at run time.
config APP_NPU
	bool "NPU runtime support"
	default y
	select USE_STM32_HAL_CACHEAXI
	select DYNAMIC_INTERRUPTS

# ctl.py "crash N": a fault on purpose, to test zprof's fault capture and the
# demo's fault alarms (tour.py does). Like the control port's other test
# commands it has no login: anyone on the LAN could stop part of the demo, or
# with "crash 4" the whole board. A build for an untrusted network leaves it out.
config APP_CRASH_TEST
	bool "The crash test command on the control port"
	default y

source "Kconfig.zephyr"
